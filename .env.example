# ===== 复制这个文件为 .env，然后把值改成你自己的 =====
# 注意：.env 已经被 .gitignore 忽略，千万不要把真实 Key 提交到 GitHub

# --- LLM（OpenAI 兼容协议，DeepSeek / 通义千问 / 智谱 都填这里）---
# DeepSeek 控制台：https://platform.deepseek.com/api_keys
# 把你的 Key 填在等号后面（形如 sk-xxxxxxxx）。
# 留空则进入「离线降级模式」：检索链路照常跑通，回答用占位文本。
# 注意：HTTP 头只能是 ASCII，别在 Key 里写中文。
OPENAI_API_KEY=
# DeepSeek 填 https://api.deepseek.com/v1
# 通义千问（兼容模式）填 https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embedding（可以和 LLM 用不同的服务商）---
# 留空 EMBED_MODEL 则使用内置的「离线伪向量」，先把链路跑通（第 6 步用）。
# ⚠️ 重要：DeepSeek 只有 chat、**没有 /embeddings 接口**，所以想用真实向量
#    必须换一家服务商。下面三个都是 OpenAI 兼容 + 有免费额度：
#      硅基流动 https://api.siliconflow.cn/v1              EMBED_MODEL=BAAI/bge-m3           EMBED_DIM=1024
#      智谱 AI  https://open.bigmodel.cn/api/paas/v4        EMBED_MODEL=embedding-3           EMBED_DIM=2048
#      阿里百炼 https://dashscope.aliyuncs.com/compatible-mode/v1  EMBED_MODEL=text-embedding-v3  EMBED_DIM=1024
#    注意 EMBED_DIM 必须和模型匹配，配错会导致「向量维度不匹配」。
#    下面两项留空 -> 自动复用上面 LLM 的 KEY / BASE_URL。
EMBED_MODEL=
EMBED_DIM=1024
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_BATCH_SIZE=10
# ^ 单次请求最多发几条文本。阿里百炼上限 20，超过会 400：
#   'batch size is invalid, it should not be larger than 20'

# --- Rerank（第 8 步 ④：真实 cross-encoder 重排）---
# 阿里百炼**同一个 EMBED_API_KEY 就能调**，不用另开账号。
# ⚠️ 端点很容易踩错：百炼的 rerank 走 DashScope 原生路径，**不支持 OpenAI 兼容端点**
#    （实测 https://dashscope.aliyuncs.com/compatible-mode/v1/rerank 返回 404），
#    所以 RERANK_BASE_URL 填**主机地址**、不要带 /compatible-mode/v1。
# 换服务商（Jina / Cohere / 智源 BGE）只改下面两行，代码不用动。
# 留空 RERANK_MODEL -> 不调 API，退化成「查询词覆盖率」基线（链路仍然完整）。
# 实测可用：gte-rerank-v2；实测不可用：gte-rerank（403 AccessDenied）。
RERANK_MODEL=
RERANK_BASE_URL=https://dashscope.aliyuncs.com
# 开关：true = 每次检索多一次 rerank 调用（更准，但更慢也更贵）
USE_RERANK=false

# --- 检索参数（第 5 / 8 / 12 步会用到）---
TOP_K=5
# 相关性阈值（第 12 步 ⑤）：向量相似度低于它的候选一律丢弃。
# 效果：库外问题检索结果为空 ⇒ 触发「拒答」，不再硬凑 5 条无关文档当引用。
# 0.49 是用本项目 40 题 golden set 实测标定的：
#   应拒答题的最高分 = 0.4875，应命中题的最低 top-1 = 0.5018（两者不重叠）。
# ⚠️ 换语料 / 换 embedding 模型后必须重标（这不是通用常数）；设 0 可关闭过滤。
MIN_SCORE=0.49
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- 本地存储 ---
# 不配就用 app/config.py 里的默认值（项目根下的绝对路径）—— 最省事也最稳。
# 如果非要换盘，请写绝对路径，例如 D:/data/docpilot/vectorstore。
# 注意：这里千万别写相对路径（如 .data/vectorstore）—— 相对路径跟着「当前工作目录」跑，
# 一旦启动目录不是项目根，索引就会存到别处，检索什么都找不到，而且不报错。
# VECTOR_DIR=D:/data/docpilot/vectorstore
# UPLOAD_DIR=D:/data/docpilot/uploads

# --- 可选：Langfuse 追踪（第 12 步 ⑥）---
# 三个都填了才启用；任一留空 = 完全不生效（app/tracing.py 全是空操作，零开销）。
# 免费注册：https://cloud.langfuse.com  → 建一个 project → Settings 里拿这两个 Key。
# ⚠️ 只填一个的话 langfuse 会打一句 "Authentication error ... Client will be disabled"
#    然后**全程静默**，很难看出是漏填了 —— 所以务必成对填。
# ⚠️ 本文档实测纠正过一句流传很广的说法：「配好环境变量就自动上报」—— 那只对
#    OpenAI SDK / LangChain 生效。本项目用裸 httpx 打协议，必须自己打点（我们已经打好了）。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 主机地址：官方名是 LANGFUSE_HOST，但控制台/自建机房常给 LANGFUSE_BASE_URL —— 两个都认。
# 例：https://cloud.langfuse.com（国际站）｜ https://jp.cloud.langfuse.com（日本机房）
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=

# --- 可选：Redis 缓存（第 13 步装了 Redis 再改成 true）---
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=true